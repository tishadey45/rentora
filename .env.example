# Better Auth secret used to sign sessions. Generate a strong random value.
BETTER_AUTH_SECRET=
# Base URL of this app (used by Better Auth).
BETTER_AUTH_URL=http://localhost:3000
# MongoDB connection string.
MONGODB_URI=
# Base URL of the Rentora backend API. Public value exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Google OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
